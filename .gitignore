# Runtime artefacts (database, ledger + certificates are generated, not source)
workspace/*.sqlite3
workspace/*.sqlite3-shm
workspace/*.sqlite3-wal
workspace/receipts/*.jsonl
workspace/exports/*.json
workspace/exports/*.pdf
workspace/exports/*.md
workspace/exports/*.csv
!workspace/receipts/.gitkeep
!workspace/exports/.gitkeep
