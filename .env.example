# --- Credentials -------------------------------------------------------------
# Required only for the live Gemini path. Without it the app runs the
# deterministic audit engine and the sidebar shows "API : OFFLINE (MOCK)".
GOOGLE_API_KEY=your_key_here

# --- Live LLM switch ---------------------------------------------------------
# 1 = use Gemini for PO/invoice parsing and the auditor narrative.
# 0 = deterministic engine only (default; safest for demos and CI).
OVERLORD_LIVE_LLM=0

# --- Model selection ---------------------------------------------------------
# gemini-2.5-flash / gemini-2.0-flash return HTTP 404 for new keys.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 0 keeps streamed stages fast; raise it for deeper auditor reasoning.
GEMINI_THINKING_BUDGET=0

# --- Local Ollama fallback (optional) ----------------------------------------
# Text-only fallback when Gemini is offline/unavailable. Vision/images stay off Ollama.
# OLLAMA_HOST=http://127.0.0.1:11434
# OVERLORD_LOCAL_MODEL=qwen2.5:5b

# --- Server ------------------------------------------------------------------
GRADIO_SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False

# --- Database / durable storage ----------------------------------------------
# Leave unset for local SQLite at workspace/overlord.sqlite3.
# For Render/production, attach Render Postgres (or another managed PostgreSQL)
# and set DATABASE_URL to its private internal URL. The app supports postgres://
# and postgresql:// URLs and normalizes them to psycopg automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/overlord
